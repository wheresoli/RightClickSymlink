[Nemo Action]
Name=Symlink From Folder…
Comment=Create a link here, pointing at another folder
# Selection=none is what puts this on the background (empty space) menu --
# Nemo is the only one of the four file managers with a first-class way to say
# "show this when nothing is selected".
Selection=none
Exec=@RCSYM@ from --dir %P --pick folder @FLAGS@
Icon-Name=rcsym-folder-from
Extensions=any;
Quote=double
