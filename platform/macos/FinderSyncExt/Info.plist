<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>FinderSyncExt</string>
    <key>CFBundleDisplayName</key>
    <string>Right Click Symlink</string>

    <!--
        MUST be the host app's identifier plus one component. macOS refuses to
        load an extension whose identifier is not nested under its container.
    -->
    <key>CFBundleIdentifier</key>
    <string>com.rightclicksymlink.app.FinderSyncExt</string>

    <key>CFBundleExecutable</key>
    <string>FinderSyncExt</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>

    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.FinderSync</string>

        <!--
            Module-qualified. `build.sh` passes -module-name FinderSyncExt, so
            the Objective-C runtime name of the Swift class is
            FinderSyncExt.FinderSync. Getting this wrong makes the extension
            load and then silently do nothing.
        -->
        <key>NSExtensionPrincipalClass</key>
        <string>FinderSyncExt.FinderSync</string>
    </dict>
</dict>
</plist>
